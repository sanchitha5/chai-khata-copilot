# Export these before running. Never commit real keys.
DB_PATH=chaikhata.db
RATE_LIMIT_PER_MIN=120
# Optional: enables LLM parsing
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Daily 9 PM sales message to the owner's WhatsApp (Twilio WhatsApp API). Without these it is only saved in Settings
# (the owner can tap "Open in WhatsApp" to send it to himself).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Needed for a message every day in production: an approved WhatsApp template with one variable {{1}} 
TWILIO_WHATSAPP_CONTENT_SID=
NOTIFY_HOUR=21
NOTIFY_ENABLED=1
TZ=Asia/Kolkata
